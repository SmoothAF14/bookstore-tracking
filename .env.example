# Application
APP_ENV=development
APP_DEBUG=True

# Service port
PORT=8003

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Django backend base URL (order/address tools call this)
DJANGO_API_URL=http://localhost:8000

# Delivery service base URL (tracking checkpoints feed its timeline)
DELIVERY_SERVICE_URL=http://localhost:8004

# ============================================================
# Redis — Celery broker + result backend + tracking state store
# Set REDIS_URL (Render's managed-Redis key) OR the two CELERY_ vars.
# If REDIS_URL is set, it's used for everything when the others are blank.
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# LLM provider — OpenRouter (OpenAI-compatible) for the orchestration loop
# ============================================================
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v3.2
LLM_MAX_TOKENS=1024

# ============================================================
# Google Maps API — MOCK DATA ONLY (no real billing/calls)
# ============================================================
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_USE_MOCK=True

# ============================================================
# Auth — verify JWT access tokens issued by the Django backend
# JWT_SECRET MUST equal the Django backend's SECRET_KEY.
# ============================================================
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIM=user_id
REQUIRE_AUTH=True
